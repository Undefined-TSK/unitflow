# 复制为 .env 后填入你自己的值。.env 不会进入版本库。
# 所有项均有默认值，此处仅列出常用配置；留空即用 config.py 中的默认值。

# —— LLM 通道 —— #
# bailian | mock。默认 bailian；缺 BAILIAN_API_KEY 时自动降级 mock（离线可用）。
LLM_PROVIDER=bailian

# 阿里云百炼 / DashScope（OpenAI 兼容模式）
# 密钥兼容两种环境变量名：BAILIAN_API_KEY 或 DASHSCOPE_API_KEY，任填其一即可
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
# embedding 向量模型：text-embedding-v3 免费额度已耗尽 → 默认切 v4（dim=1024 与 v3 相同）。
# 切后建议清空 EMBED_CACHE_DIR 并按 2b 策略重建向量表（v3/v4 向量空间不同）。
BAILIAN_EMBED_MODEL=text-embedding-v4
BAILIAN_EMBED_V4_MODEL=text-embedding-v4
BAILIAN_TEMPERATURE=0.3
BAILIAN_MAX_TOKENS=1500

# —— LLM 调用重试（网络错误 / 429 / 5xx 指数退避；4xx 不重试） —— #
LLM_MAX_RETRIES=3         # 总尝试次数（含首次），即最多重试 2 次
LLM_RETRY_BACKOFF=1.0     # 首次退避秒数，之后 ×2 递增（1s → 2s → 4s）

# —— 结构化日志（JSON 行 + 轮转，目录缺省 <数据目录>/logs） —— #
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
LOG_DIR=                  # 自定义日志目录；留空=数据目录下 logs/

# —— ask 端点配额（桌面单机防费用失控 / 服务雪堆） —— #
MAX_CONCURRENT_ASK=2      # 同时处理的 ask 请求上限（其余排队）
ASK_RATE_PER_MIN=10       # 每分钟 ask 请求上限（60 秒滑窗）
ASK_QUEUE_TIMEOUT=30      # 排队等待执行权的最长秒数，超时返回 429

# —— 本地 Bearer Token 鉴权（默认关；暴露到局域网/公网时开启） —— #
AUTH_ENABLE=false         # true=除 /、/static、/api/status 外全部需令牌
AUTH_TOKEN=               # 显式令牌；留空则用数据目录 token 文件（首次启用自动生成，权限 600）

# 本地 Ollama（LLM_PROVIDER=ollama 时启用；未运行则降级百炼）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# —— 检索 —— #
TOP_K_PER_STAGE=3          # 每路检索（向量/BM25）返回的候选数
FETCH_TIMEOUT=6            # 网络抓取超时（秒），不可达时降级本地语料
ENABLE_WEB_FETCH=true      # true=允许抓取导入的网址；false=仅本地语料
PRESET_SOURCES_ENABLE=true # true=首次启动后台导入预置权威资料源（Python 官方文档/CPython/官方论坛）；需配合 ENABLE_WEB_FETCH=true 才真实抓取

# —— 嵌入向量落盘缓存（额度保护；切 embedding 模型后须清空该目录）——
EMBED_CACHE_DIR=            # 留空=数据目录下 embed_cache/；自定义请给绝对路径

# —— 极端场景防护（宁严勿崩） —— #
MAX_UPLOAD_MB=50           # 单文件上传上限（MB），超限直接 413
MAX_QUERY_CHARS=4000       # 单次提问长度上限（字符），超出截断
PARSE_TIMEOUT=120          # 离线文档解析超时（秒），超时放弃该文件
MAX_PAGES_PER_SITE=6       # 单站抓取页数上限（防站点过大）

# —— 长上下文管理（多轮对话 token 预算） —— #
CONTEXT_TOKEN_BUDGET=6000  # 会话上下文 token 预算（中英文混合粗估）
CONTEXT_KEEP_TURNS=4       # 超预算时始终完整保留的最近轮数
CONTEXT_SUMMARY_TRIGGER=8  # 超过 N 轮触发滚动摘要

# —— 本地重排模型（bge-reranker，首次使用自动下载） —— #
RERANK_LOCAL_ENABLE=true
RERANK_LOCAL_MODEL=BAAI/bge-reranker-base   # 1.1GB；要更高质量可换 BAAI/bge-reranker-v2-m3（2.2GB）
HF_ENDPOINT=https://hf-mirror.com           # HuggingFace 国内镜像；海外机器可删掉此行

# —— MCP 协议层（真实接入，stdio 子进程） —— #
# 依赖：Node.js（filesystem/thinking 走 npx）+ Python mcp-server-fetch。
# Node 不可用时对应通道自动降级，不影响其他功能。
MCP_ENABLE=true            # 总开关
MCP_FS_DIR=                # filesystem 授权目录（缺省=数据目录）；留空=仅项目数据目录
MCP_FETCH_ENABLE=true      # MCP fetch server：网页正文抽取（失败降级 requests+trafilatura）
MCP_THINKING_ENABLE=true   # MCP sequential-thinking：复杂问题分步推理便笺

# —— 答案交叉审阅（A2A 轻量替代：双模型二审） —— #
REVIEW_ENABLE=true
REVIEW_MODEL=              # 审阅用模型，缺省用 BAILIAN_MODEL；可设 qwen-max 增强

# —— 自进化（Reflexion 反思 + Voyager 技能沉淀；不微调权重，prompt/记忆层进化） —— #
# 关闭后问答链路零反思/零沉淀，/api/evolve 等端点返回 503（设置页插件面板也可关）
EVOLUTION_ENABLE=true

# —— 百炼模型预留入口（在控制台开通对应模型后，取消注释即零改代码生效）——
# 不开通也有降级链，见 pypedia/models/registry.py
# 重排：gte-rerank 已官方下线，默认走本地 bge-reranker（见上）
# BAILIAN_RERANK_MODEL=qwen3-rerank
# 决策模型（主/辅源与置信度判定，未开通降级 qwen-plus）
# BAILIAN_DECISION_MODEL=decision-model-preview
# 代码专用模型
# BAILIAN_CODER_MODEL=qwen3-coder-plus
# 数学/算法复杂度推导
# BAILIAN_MATH_MODEL=qwen-math-plus
# 视觉理解（读图/截图 → 可视化讲解）
# BAILIAN_VISION_MODEL=qwen-vl-max
# 文生图（为知识点生成示意图）
# BAILIAN_T2I_MODEL=wanx2.1-t2i-turbo
# 语音合成（播报答案）
# BAILIAN_TTS_MODEL=qwen-tts
# 语音识别（语音输入提问）
# BAILIAN_ASR_MODEL=paraformer-realtime-v2
# 向量模型 v4：已在上方设为默认（v3 免费额度耗尽）；此行仅作覆盖示例
# BAILIAN_EMBED_V4_MODEL=text-embedding-v4
